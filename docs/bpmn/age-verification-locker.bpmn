    <bpmn:startEvent id="Start_Our_CreateParcel" name="Отримано запит на створення посилки">
      <bpmn:outgoing>F_OUR_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_Our_CreateParcel_MessageDef" />
