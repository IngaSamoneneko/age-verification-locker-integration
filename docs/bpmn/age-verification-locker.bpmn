    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F_CX_01" sourceRef="Start_CX" targetRef="Task_CX_CreateParcel" />
    <bpmn:sequenceFlow id="F_CX_02" sourceRef="Task_CX_CreateParcel" targetRef="Event_CX_ReceiveParcelModel" />
    <bpmn:sequenceFlow id="F_CX_03" sourceRef="Event_CX_ReceiveParcelModel" targetRef="Task_CX_CourierDeliver" />
