    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_CX_RequestDiia" name="Ініціювати підтвердження віку через Дію">
      <bpmn:incoming>F_CX_06</bpmn:incoming>
      <bpmn:outgoing>F_CX_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_CX_DiiaResult" name="Отримати результат підтвердження">
      <bpmn:incoming>F_CX_07</bpmn:incoming>
      <bpmn:outgoing>F_CX_08</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_CX_DiiaResult_MessageDef" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sendTask id="Task_CX_SendCustomerCode" name="Передати Customer Code користувачу">
      <bpmn:incoming>F_CX_04</bpmn:incoming>
      <bpmn:outgoing>F_CX_05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sendTask id="Task_CX_ShowFailure" name="Показати відмову або помилку підтвердження">
      <bpmn:incoming>F_CX_10</bpmn:incoming>
      <bpmn:outgoing>F_CX_13</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_CX_Failure" name="Підтвердження неуспішне">
      <bpmn:incoming>F_CX_13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_CX_AgeConfirmed" name="Вік підтверджено?">
      <bpmn:incoming>F_CX_08</bpmn:incoming>
      <bpmn:outgoing>F_CX_10</bpmn:outgoing>
