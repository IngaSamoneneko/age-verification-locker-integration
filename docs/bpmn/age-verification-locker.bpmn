    <bpmn:sequenceFlow id="F_CX_12" sourceRef="Task_CX_ShowAgeCode" targetRef="End_CX_Success" />
  </bpmn:process>
  <bpmn:process id="Process_OurSystem" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Process_OurSystem">
      <bpmn:lane id="Lane_Our_Locker" name="ПЗ поштомата">
