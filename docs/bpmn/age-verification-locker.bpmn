        <bpmn:flowNodeRef>Task_CX_SendCustomerCode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CX_AgeConfirmed</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_CX" name="Замовлення оформлено, посилка готова до створення">
      <bpmn:outgoing>F_CX_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sendTask id="Task_CX_CreateParcel" name="Створити посилку через API з ознакою перевірки віку">
